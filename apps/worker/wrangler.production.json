{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "misthy-meme-party-production",
  "account_id": "4b9fba34f01a0b76effc28b9c7c93a6f",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/ws", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_SESSIONS",
        "class_name": "GameSession"
      }
    ]
  },
  "exports": {
    "GameSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misthy-meme-db",
      "database_id": "2424fbcb-ab77-4767-bd7f-342f7c02d017",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEME_BUCKET",
      "bucket_name": "misthy-meme-assets"
    }
  ],
  "vars": {
    "MAX_UPLOAD_BYTES": "10485760"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
