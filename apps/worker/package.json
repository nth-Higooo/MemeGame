{
  "name": "@misthy/worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf:typegen": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node ../../scripts/production.mjs migrate",
    "deploy": "node ../../scripts/production.mjs deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@misthy/game-engine": "workspace:*",
    "@misthy/shared": "workspace:*",
    "hono": "4.13.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "wrangler": "4.156.0"
  }
}
