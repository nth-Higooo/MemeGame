{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misthy-meme-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_SESSIONS", "class_name": "GameSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameSession"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misthy-meme-party",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEME_BUCKET",
      "bucket_name": "misthy-meme-library"
    }
  ],
  "observability": { "enabled": true }
}
