{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "misthy-meme-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "GAME_SESSIONS", "class_name": "GameSession" }],
  },
  "exports": {
    "GameSession": { "type": "durable-object", "storage": "sqlite" },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misthy-meme-party",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEME_BUCKET",
      "bucket_name": "misthy-meme-library",
    },
  ],
  "observability": { "enabled": true },
}
