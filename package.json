{
  "name": "misthy-meme-party",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @misthy/shared build && pnpm --filter @misthy/game-engine build && pnpm --filter @misthy/web build && pnpm --filter @misthy/worker build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm build && pnpm --filter @misthy/worker deploy",
    "dev": "pnpm --parallel --filter @misthy/web --filter @misthy/worker dev",
    "dev:single-origin": "pnpm --filter @misthy/web build && pnpm --filter @misthy/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "cf:typegen": "pnpm --filter @misthy/worker cf:typegen",
    "db:migrate:local": "pnpm --filter @misthy/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @misthy/worker db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.0",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
