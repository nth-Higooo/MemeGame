# Public browser configuration. Never place secrets in VITE_* variables.
VITE_API_BASE_URL=http://localhost:8787
VITE_WS_BASE_URL=ws://localhost:8787

# Copy secret values to apps/worker/.dev.vars for local development.
# Configure production values with `wrangler secret put`, never in this file.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-one-time-password

# Maximum accepted image upload in bytes. Default: 10 MiB.
MAX_UPLOAD_BYTES=10485760
